<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ShieldFlow — Dashboard</title>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,700;12..96,800&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root {
  --bg:#07090f; --surface:#0e1119; --surface2:#151b26; --surface3:#1c2433;
  --border:#1e2d3d; --border2:#263547;
  --text:#e8edf5; --text2:#8b9ab0; --text3:#4a5a6e;
  --accent:#2563eb; --accent2:#3b82f6; --glow:rgba(37,99,235,.15);
  --green:#10b981; --red:#ef4444; --amber:#f59e0b; --orange:#f97316;
  --font:'Bricolage Grotesque',sans-serif; --mono:'DM Mono',monospace;
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;overflow:hidden}
body{background:var(--bg);color:var(--text);font-family:var(--font);font-size:13px;display:flex}
::-webkit-scrollbar{width:4px} ::-webkit-scrollbar-thumb{background:var(--border2);border-radius:4px}
button,input,textarea{font-family:var(--font)}

/* LOGIN */
.login-screen{position:fixed;inset:0;background:var(--bg);z-index:1000;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:0}
.login-box{background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:40px;width:360px}
.login-logo{display:flex;align-items:center;gap:10px;margin-bottom:32px}
.login-logo-mark{width:36px;height:36px;background:var(--accent);border-radius:9px;display:flex;align-items:center;justify-content:center}
.login-logo-mark svg{width:18px;height:18px}
.login-title{font-size:20px;font-weight:800;letter-spacing:-.03em}
.login-sub{font-size:13px;color:var(--text3);margin-bottom:28px}
.login-label{font-size:11px;color:var(--text3);font-family:var(--mono);margin-bottom:6px;display:block}
.login-input{width:100%;background:var(--surface2);border:1px solid var(--border);border-radius:8px;padding:10px 14px;font-size:13px;color:var(--text);outline:none;transition:border-color .15s;margin-bottom:10px}
.login-input:focus{border-color:var(--accent)}
.login-btn{width:100%;background:var(--accent);color:#fff;border:none;border-radius:8px;padding:12px;font-size:14px;font-weight:700;cursor:pointer;margin-top:8px;transition:background .15s}
.login-btn:hover{background:var(--accent2)}
.login-error{font-size:12px;color:var(--red);margin-top:8px;display:none}
.login-server{font-size:11px;color:var(--text3);font-family:var(--mono);margin-top:16px;text-align:center}

/* APP */
.app-wrap{display:flex;width:100%;height:100%;opacity:0;pointer-events:none;transition:opacity .3s}
.app-wrap.visible{opacity:1;pointer-events:all}

/* SIDEBAR */
.sidebar{width:220px;background:var(--surface);border-right:1px solid var(--border);display:flex;flex-direction:column;flex-shrink:0;height:100vh}
.sidebar-logo{height:56px;display:flex;align-items:center;gap:10px;padding:0 16px;border-bottom:1px solid var(--border);flex-shrink:0}
.logo-mark{width:28px;height:28px;background:var(--accent);border-radius:7px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.logo-mark svg{width:14px;height:14px}
.logo-name{font-size:15px;font-weight:800;letter-spacing:-.03em}
.logo-badge{font-family:var(--mono);font-size:8px;color:var(--text3)}
.nav{flex:1;overflow-y:auto;padding:10px 0}
.nav-section{font-family:var(--mono);font-size:9px;color:var(--text3);letter-spacing:.12em;text-transform:uppercase;padding:10px 16px 4px}
.nav-item{display:flex;align-items:center;gap:9px;padding:8px 16px;color:var(--text2);cursor:pointer;border-left:2px solid transparent;transition:all .12s;font-size:13px;font-weight:500}
.nav-item:hover{color:var(--text);background:rgba(255,255,255,.03)}
.nav-item.active{color:var(--accent2);border-left-color:var(--accent);background:var(--glow)}
.nav-item svg{width:14px;height:14px;flex-shrink:0}
.nav-pill{margin-left:auto;font-size:9px;font-family:var(--mono);border-radius:10px;padding:2px 6px;font-weight:500}
.nav-pill.red{background:rgba(239,68,68,.15);color:var(--red)}
.sidebar-user{border-top:1px solid var(--border);padding:14px 16px;display:flex;align-items:center;gap:10px;flex-shrink:0}
.user-av{width:30px;height:30px;border-radius:50%;background:linear-gradient(135deg,var(--accent),#8b5cf6);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:800;color:#fff;flex-shrink:0}
.user-name{font-size:12px;font-weight:700}
.user-role{font-size:10px;color:var(--text3)}
.logout-btn{margin-left:auto;background:none;border:none;color:var(--text3);cursor:pointer;font-size:11px;font-family:var(--mono)}
.logout-btn:hover{color:var(--red)}

/* MAIN */
.main{flex:1;display:flex;flex-direction:column;overflow:hidden;min-width:0}
.topbar{height:56px;background:var(--surface);border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;padding:0 24px;flex-shrink:0}
.page-title{font-size:15px;font-weight:800;letter-spacing:-.02em}
.topbar-right{display:flex;align-items:center;gap:8px}
.status-pill{display:flex;align-items:center;gap:5px;background:rgba(16,185,129,.08);border:1px solid rgba(16,185,129,.2);border-radius:20px;padding:4px 10px;font-size:10px;color:var(--green);font-family:var(--mono)}
.pulsedot{width:5px;height:5px;border-radius:50%;background:var(--green);animation:pd 2s infinite}
@keyframes pd{0%,100%{opacity:1}50%{opacity:.3}}
.tb-btn{width:30px;height:30px;border-radius:7px;background:var(--surface2);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;cursor:pointer;color:var(--text2);transition:all .12s}
.tb-btn:hover{border-color:var(--border2);color:var(--text)}
.tb-btn svg{width:14px;height:14px}
.refresh-btn{display:flex;align-items:center;gap:6px;background:var(--surface2);border:1px solid var(--border);border-radius:7px;padding:7px 14px;font-size:12px;font-weight:600;color:var(--text2);cursor:pointer;transition:all .12s}
.refresh-btn:hover{border-color:var(--accent);color:var(--accent2)}
.content{flex:1;overflow-y:auto;padding:20px 24px}

/* EMPTY STATE */
.empty-state{display:flex;flex-direction:column;align-items:center;justify-content:center;height:300px;gap:16px;text-align:center}
.empty-icon{font-size:48px}
.empty-title{font-size:18px;font-weight:800;letter-spacing:-.02em}
.empty-desc{font-size:13px;color:var(--text2);max-width:400px;line-height:1.6}
.empty-cmd{background:var(--surface2);border:1px solid var(--border);border-radius:8px;padding:12px 16px;font-family:var(--mono);font-size:12px;color:var(--accent2);margin-top:4px;text-align:left;white-space:pre;overflow-x:auto;max-width:100%}
.copy-btn{background:var(--accent);color:#fff;border:none;border-radius:7px;padding:8px 16px;font-size:12px;font-weight:700;cursor:pointer;transition:background .12s}
.copy-btn:hover{background:var(--accent2)}

/* METRICS */
.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:16px}
.mc{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:16px;cursor:pointer;transition:border-color .15s,transform .15s}
.mc:hover{border-color:var(--border2);transform:translateY(-1px)}
.mc-label{font-size:10px;color:var(--text3);font-family:var(--mono);text-transform:uppercase;letter-spacing:.08em;margin-bottom:8px}
.mc-val{font-size:28px;font-weight:800;letter-spacing:-.03em;line-height:1;margin-bottom:5px}
.mc-sub{font-size:10px;color:var(--text3)}

/* PANEL */
.panel{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:16px;margin-bottom:12px}
.panel-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}
.panel-title{font-size:11px;font-weight:700;color:var(--text2);text-transform:uppercase;letter-spacing:.08em;font-family:var(--mono)}
.panel-action{font-size:11px;color:var(--accent2);cursor:pointer;font-family:var(--mono)}

/* GRID */
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px}
.grid32{display:grid;grid-template-columns:3fr 2fr;gap:12px;margin-bottom:12px}

/* DEVICE CARD */
.device-card{background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:14px;cursor:pointer;transition:border-color .15s;display:flex;align-items:center;gap:12px;margin-bottom:8px}
.device-card:hover{border-color:var(--border2)}
.device-icon{width:36px;height:36px;border-radius:8px;background:var(--surface2);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0}
.device-info{flex:1;min-width:0}
.device-name{font-size:13px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.device-meta{font-size:10px;color:var(--text3);font-family:var(--mono);margin-top:2px}
.device-status{display:flex;align-items:center;gap:6px;font-size:10px;font-family:var(--mono)}
.status-dot{width:7px;height:7px;border-radius:50%;flex-shrink:0}

/* ALERT ITEM */
.alert-item{background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:12px;margin-bottom:7px;cursor:pointer;transition:border-color .15s;display:flex;align-items:flex-start;gap:10px}
.alert-item:hover{border-color:var(--border2)}
.sev-dot{width:7px;height:7px;border-radius:50%;flex-shrink:0;margin-top:4px}
.sev-dot.critical{background:var(--red);box-shadow:0 0 6px rgba(239,68,68,.5)}
.sev-dot.high{background:var(--orange)}
.sev-dot.medium{background:var(--amber)}
.sev-dot.low{background:var(--green)}
.alert-body{flex:1;min-width:0}
.alert-title{font-size:12px;font-weight:600}
.alert-desc{font-size:11px;color:var(--text2);margin-top:3px;line-height:1.5}
.alert-meta{font-size:10px;color:var(--text3);font-family:var(--mono);margin-top:4px}
.sev-tag{font-size:9px;font-weight:700;font-family:var(--mono);padding:2px 7px;border-radius:5px;flex-shrink:0;white-space:nowrap}
.tag-critical{background:rgba(239,68,68,.1);color:var(--red);border:1px solid rgba(239,68,68,.2)}
.tag-high{background:rgba(249,115,22,.1);color:var(--orange);border:1px solid rgba(249,115,22,.2)}
.tag-medium{background:rgba(245,158,11,.1);color:var(--amber);border:1px solid rgba(245,158,11,.2)}
.tag-low{background:rgba(16,185,129,.1);color:var(--green);border:1px solid rgba(16,185,129,.2)}

/* SCORE */
.score-num{font-size:52px;font-weight:800;letter-spacing:-.05em;line-height:1;text-align:center;margin:8px 0 4px}
.score-sub{font-size:11px;color:var(--text3);text-align:center;margin-bottom:14px}
.sbar{display:flex;align-items:center;gap:8px;margin-bottom:7px}
.sbar-label{font-size:10px;color:var(--text2);width:54px;flex-shrink:0}
.sbar-track{flex:1;height:4px;background:var(--surface3);border-radius:2px;overflow:hidden}
.sbar-fill{height:100%;border-radius:2px;transition:width 1s ease}
.sbar-val{font-family:var(--mono);font-size:10px;color:var(--text2);width:26px;text-align:right}

/* METRIC CHART (sparkline) */
.chart-wrap{display:flex;flex-direction:column;gap:5px}
.chart-bars{display:flex;align-items:flex-end;gap:3px;height:60px}
.chart-bar{flex:1;border-radius:2px 2px 0 0;min-height:2px;cursor:pointer;transition:opacity .15s}
.chart-bar:hover{opacity:.75}
.chart-days{display:flex;gap:3px}
.chart-day{flex:1;text-align:center;font-family:var(--mono);font-size:9px;color:var(--text3)}

/* MODAL */
.overlay{position:fixed;inset:0;background:rgba(0,0,0,.75);backdrop-filter:blur(6px);z-index:200;display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .2s}
.overlay.open{opacity:1;pointer-events:all}
.modal{background:var(--surface);border:1px solid var(--border2);border-radius:14px;width:520px;max-width:90vw;max-height:80vh;overflow-y:auto;transform:translateY(10px);transition:transform .2s}
.overlay.open .modal{transform:translateY(0)}
.modal-head{display:flex;align-items:flex-start;justify-content:space-between;padding:20px 20px 0}
.modal-title{font-size:16px;font-weight:800;letter-spacing:-.02em}
.modal-close{width:26px;height:26px;border-radius:6px;background:var(--surface2);border:1px solid var(--border);color:var(--text2);cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.modal-body{padding:14px 20px 20px}
.modal-actions{display:flex;gap:8px;margin-top:16px;flex-wrap:wrap}
.mbtn{padding:9px 16px;border-radius:8px;font-size:12px;font-weight:700;border:none;cursor:pointer;transition:opacity .15s}
.mbtn:hover{opacity:.85}
.mbtn-danger{background:var(--red);color:#fff}
.mbtn-primary{background:var(--accent);color:#fff}
.mbtn-ghost{background:var(--surface2);color:var(--text2);border:1px solid var(--border)}

/* DEVICE DETAIL */
.stat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:16px}
.stat-box{background:var(--surface2);border-radius:8px;padding:12px;text-align:center}
.stat-val{font-size:22px;font-weight:800;letter-spacing:-.03em}
.stat-label{font-size:10px;color:var(--text3);font-family:var(--mono);margin-top:3px}

/* TOAST */
#toastwrap{position:fixed;bottom:20px;right:20px;z-index:999;display:flex;flex-direction:column;gap:8px}
.toast{background:var(--surface2);border:1px solid var(--border2);border-radius:10px;padding:11px 16px;font-size:12px;display:flex;align-items:center;gap:9px;box-shadow:0 8px 32px rgba(0,0,0,.4);transform:translateX(120%);transition:transform .3s cubic-bezier(.34,1.56,.64,1);max-width:300px}
.toast.show{transform:translateX(0)}
.toast-ico{width:7px;height:7px;border-radius:50%;flex-shrink:0}

/* LOADING */
.loading{display:flex;align-items:center;justify-content:center;height:200px}
.spinner{width:32px;height:32px;border:2px solid var(--border2);border-top-color:var(--accent);border-radius:50%;animation:spin 1s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes fadeIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}
.page-anim{animation:fadeIn .2s ease}

/* INFO BOX */
.info-box{background:var(--surface2);border:1px solid var(--border);border-radius:10px;padding:16px;margin-bottom:12px}
.info-box.warn{border-color:rgba(245,158,11,.3);background:rgba(245,158,11,.05)}
.info-box.ok{border-color:rgba(16,185,129,.3);background:rgba(16,185,129,.05)}
.info-title{font-size:12px;font-weight:700;margin-bottom:6px}
.info-text{font-size:12px;color:var(--text2);line-height:1.6}
.info-cmd{font-family:var(--mono);font-size:11px;color:var(--accent2);background:var(--bg);border-radius:6px;padding:8px 12px;margin-top:8px;display:block;cursor:pointer;border:1px solid var(--border)}
</style>
</head>
<body>

<!-- LOGIN -->
<div class="login-screen" id="loginScreen">
  <div class="login-box">
    <div class="login-logo">
      <div class="login-logo-mark">
        <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      </div>
      <div>
        <div style="font-size:17px;font-weight:800;letter-spacing:-.03em">ShieldFlow</div>
        <div style="font-size:10px;color:var(--text3);font-family:var(--mono)">v1.0 MVP</div>
      </div>
    </div>
    <div class="login-sub">Connectez-vous pour accéder à votre tableau de bord.</div>
    <label class="login-label">Serveur ShieldFlow</label>
    <input class="login-input" id="serverUrl" value="http://localhost:3000" placeholder="http://localhost:3000">
    <label class="login-label">Mot de passe</label>
    <input class="login-input" id="password" type="password" placeholder="Mot de passe admin" onkeydown="if(event.key==='Enter')login()">
    <div class="login-error" id="loginError">Mot de passe incorrect ou serveur inaccessible.</div>
    <button class="login-btn" onclick="login()">Se connecter →</button>
    <div class="login-server" id="loginServerInfo">Le backend doit être lancé sur votre machine.</div>
  </div>
</div>

<!-- APP -->
<div class="app-wrap" id="appWrap">
  <!-- SIDEBAR -->
  <div class="sidebar">
    <div class="sidebar-logo">
      <div class="logo-mark">
        <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      </div>
      <div><div class="logo-name">ShieldFlow</div><div class="logo-badge">v1.0 MVP</div></div>
    </div>
    <div class="nav">
      <div class="nav-section">Surveillance</div>
      <div class="nav-item active" onclick="go('dashboard')">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
        Vue d'ensemble
      </div>
      <div class="nav-item" onclick="go('appareils')">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
        Appareils
        <span class="nav-pill" id="nav-devices-count" style="background:rgba(37,99,235,.15);color:var(--accent2)">0</span>
      </div>
      <div class="nav-item" onclick="go('alertes')">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0zM12 9v4M12 17h.01"/></svg>
        Alertes
        <span class="nav-pill red" id="nav-alerts-count">0</span>
      </div>
      <div class="nav-section">Connecter</div>
      <div class="nav-item" onclick="go('connecter')">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71"/></svg>
        Connecter un appareil
      </div>
    </div>
    <div class="sidebar-user">
      <div class="user-av">A</div>
      <div><div class="user-name">Admin</div><div class="user-role">ShieldFlow</div></div>
      <button class="logout-btn" onclick="logout()">Quitter</button>
    </div>
  </div>

  <!-- MAIN -->
  <div class="main">
    <div class="topbar">
      <div class="page-title" id="pageTitle">Vue d'ensemble</div>
      <div class="topbar-right">
        <div class="status-pill"><span class="pulsedot"></span> <span id="serverStatus">Connecté</span></div>
        <button class="refresh-btn" onclick="refreshData()">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 11-2.12-9.36L23 10"/></svg>
          Actualiser
        </button>
      </div>
    </div>
    <div class="content" id="content"></div>
  </div>
</div>

<!-- MODAL -->
<div class="overlay" id="overlay" onclick="closeModal(event)">
  <div class="modal">
    <div class="modal-head">
      <div class="modal-title" id="m-title"></div>
      <button class="modal-close" onclick="closeModal()">✕</button>
    </div>
    <div class="modal-body" id="m-body"></div>
  </div>
</div>

<!-- TOAST -->
<div id="toastwrap"></div>

<script>
// ═══════════════════════════════════════════════════════
// ÉTAT GLOBAL
// ═══════════════════════════════════════════════════════
const S = {
  token: localStorage.getItem('sf_token') || null,
  server: localStorage.getItem('sf_server') || 'http://localhost:3000',
  data: { devices: [], alerts: [], dashboard: null },
  currentPage: 'dashboard',
  refreshTimer: null
};

// ═══════════════════════════════════════════════════════
// API
// ═══════════════════════════════════════════════════════
async function api(method, path, body) {
  const opts = {
    method,
    headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${S.token}` }
  };
  if (body) opts.body = JSON.stringify(body);
  const r = await fetch(S.server + path, opts);
  if (r.status === 401) { logout(); return null; }
  if (!r.ok) throw new Error(`${r.status} ${r.statusText}`);
  return r.json();
}

// ═══════════════════════════════════════════════════════
// AUTH
// ═══════════════════════════════════════════════════════
async function login() {
  const server = document.getElementById('serverUrl').value.trim().replace(/\/$/, '');
  const password = document.getElementById('password').value;
  const errEl = document.getElementById('loginError');
  errEl.style.display = 'none';

  try {
    const r = await fetch(server + '/api/auth/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ password })
    });
    if (!r.ok) { errEl.style.display = 'block'; return; }
    const data = await r.json();
    S.token = data.token;
    S.server = server;
    localStorage.setItem('sf_token', data.token);
    localStorage.setItem('sf_server', server);
    showApp();
  } catch(e) {
    errEl.textContent = 'Impossible de joindre le serveur. Vérifiez l\'URL et que le backend est lancé.';
    errEl.style.display = 'block';
  }
}

function logout() {
  S.token = null;
  localStorage.removeItem('sf_token');
  localStorage.removeItem('sf_server');
  document.getElementById('appWrap').classList.remove('visible');
  document.getElementById('loginScreen').style.display = 'flex';
  clearInterval(S.refreshTimer);
}

async function showApp() {
  document.getElementById('loginScreen').style.display = 'none';
  document.getElementById('appWrap').classList.add('visible');
  await refreshData();
  // Auto-refresh toutes les 30 secondes
  S.refreshTimer = setInterval(refreshData, 30000);
  go('dashboard');
}

// ═══════════════════════════════════════════════════════
// DONNÉES
// ═══════════════════════════════════════════════════════
async function refreshData() {
  try {
    const [dashboard, devices, alerts] = await Promise.all([
      api('GET', '/api/dashboard'),
      api('GET', '/api/devices'),
      api('GET', '/api/alerts')
    ]);
    S.data.dashboard = dashboard;
    S.data.devices = devices || [];
    S.data.alerts = alerts || [];

    // Mettre à jour les badges de nav
    document.getElementById('nav-devices-count').textContent = S.data.devices.length;
    document.getElementById('nav-alerts-count').textContent = S.data.alerts.filter(a => !a.resolved).length;
    document.getElementById('serverStatus').textContent = 'Connecté';

    // Re-render la page courante
    render(S.currentPage);
  } catch(e) {
    document.getElementById('serverStatus').textContent = 'Hors ligne';
    toast('Impossible de joindre le serveur', 'red');
  }
}

// ═══════════════════════════════════════════════════════
// NAVIGATION
// ═══════════════════════════════════════════════════════
const PAGE_TITLES = {
  dashboard: 'Vue d\'ensemble',
  appareils: 'Appareils',
  alertes: 'Alertes de sécurité',
  connecter: 'Connecter un appareil'
};

function go(page) {
  S.currentPage = page;
  document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(el => {
    if (el.getAttribute('onclick') && el.getAttribute('onclick').includes(`'${page}'`)) el.classList.add('active');
  });
  document.getElementById('pageTitle').textContent = PAGE_TITLES[page] || page;
  render(page);
}

function render(page) {
  const c = document.getElementById('content');
  const div = document.createElement('div');
  div.className = 'page-anim';
  const pages = { dashboard: pageDashboard, appareils: pageAppareils, alertes: pageAlertes, connecter: pageConnecter };
  div.innerHTML = (pages[page] || (() => ''))();
  c.innerHTML = '';
  c.appendChild(div);
  // Post-render hooks
  if (page === 'dashboard') renderChart();
}

// ═══════════════════════════════════════════════════════
// PAGE : DASHBOARD
// ═══════════════════════════════════════════════════════
function pageDashboard() {
  const d = S.data.dashboard;
  const devices = S.data.devices;
  const alerts = S.data.alerts;

  if (!d || devices.length === 0) {
    return `
    <div class="empty-state">
      <div class="empty-icon">🛡️</div>
      <div class="empty-title">Aucun appareil connecté</div>
      <div class="empty-desc">Votre dashboard est prêt. Connectez votre premier appareil pour commencer à surveiller votre infrastructure.</div>
      <button class="copy-btn" onclick="go('connecter')">→ Connecter mon MacBook</button>
    </div>`;
  }

  const score = d.score;
  const scoreColor = score >= 80 ? 'var(--green)' : score >= 60 ? 'var(--amber)' : 'var(--red)';
  const critAlerts = alerts.filter(a => a.severity === 'critical');
  const highAlerts = alerts.filter(a => a.severity === 'high');

  // Dernière snapshot d'un appareil online
  const onlineDevice = devices.find(dev => dev.status === 'online' && dev.latest_snapshot);
  const snap = onlineDevice?.latest_snapshot;

  return `
  <div class="metrics">
    <div class="mc" onclick="go('alertes')">
      <div class="mc-label">Alertes actives</div>
      <div class="mc-val" style="color:${alerts.length > 0 ? 'var(--red)' : 'var(--green)'}">${alerts.length}</div>
      <div class="mc-sub">${critAlerts.length} critique(s) · ${highAlerts.length} élevée(s)</div>
    </div>
    <div class="mc">
      <div class="mc-label">Score de sécurité</div>
      <div class="mc-val" style="color:${scoreColor}">${score}</div>
      <div class="mc-sub">${score >= 80 ? 'Bon niveau' : score >= 60 ? 'À améliorer' : 'Risque élevé'}</div>
    </div>
    <div class="mc" onclick="go('appareils')">
      <div class="mc-label">Appareils</div>
      <div class="mc-val" style="color:var(--accent2)">${d.devices.total}</div>
      <div class="mc-sub">${d.devices.online} en ligne · ${d.devices.offline} hors ligne</div>
    </div>
    <div class="mc">
      <div class="mc-label">Résolues aujourd'hui</div>
      <div class="mc-val" style="color:var(--green)">${d.alerts.resolved_today}</div>
      <div class="mc-sub">Alertes corrigées</div>
    </div>
  </div>

  <div class="grid32">
    <div>
      <div class="panel">
        <div class="panel-head">
          <div class="panel-title">Alertes récentes</div>
          <span class="panel-action" onclick="go('alertes')">Tout voir →</span>
        </div>
        ${alerts.length === 0
          ? `<div style="text-align:center;padding:24px;color:var(--text3);font-size:12px">✅ Aucune alerte active — infrastructure saine</div>`
          : alerts.slice(0, 5).map(a => alertRow(a)).join('')
        }
      </div>

      ${snap ? `
      <div class="panel">
        <div class="panel-head">
          <div class="panel-title">Ressources — ${onlineDevice.name}</div>
          <span style="font-size:10px;color:var(--text3);font-family:var(--mono)">Temps réel</span>
        </div>
        <div style="display:flex;flex-direction:column;gap:10px">
          ${resourceBar('CPU', snap.cpu_percent, '%')}
          ${resourceBar('RAM', snap.ram_percent, `% (${snap.ram_total_gb} GB)`)}
          ${resourceBar('Disque', snap.disk_percent, `% (${snap.disk_total_gb} GB)`)}
        </div>
        <div style="display:flex;gap:16px;margin-top:14px;padding-top:12px;border-top:1px solid var(--border)">
          <div style="font-size:11px;color:var(--text3)">Processus : <span style="color:var(--text2)">${snap.running_processes}</span></div>
          <div style="font-size:11px;color:var(--text3)">Connexions : <span style="color:var(--text2)">${snap.network_connections}</span></div>
          <div style="font-size:11px;color:var(--text3)">Uptime : <span style="color:var(--text2)">${Math.round(snap.uptime_hours)}h</span></div>
          <div style="font-size:11px;color:var(--text3)">OS : <span style="color:var(--text2)">${snap.os_version || '-'}</span></div>
        </div>
      </div>` : ''}
    </div>

    <div>
      <div class="panel">
        <div class="panel-head"><div class="panel-title">Score de sécurité</div></div>
        <div class="score-num" style="color:${scoreColor}">${score}</div>
        <div class="score-sub">${score >= 80 ? '✅ Infrastructure bien protégée' : score >= 60 ? '⚠ Des améliorations sont nécessaires' : '🔴 Risques critiques à traiter'}</div>
        <div class="sbar"><div class="sbar-label">Alertes</div><div class="sbar-track"><div class="sbar-fill" style="width:${Math.max(5,100-alerts.length*10)}%;background:${alerts.length === 0 ? 'var(--green)' : 'var(--red)'}"></div></div><div class="sbar-val">${alerts.length === 0 ? 'OK' : alerts.length}</div></div>
        <div class="sbar"><div class="sbar-label">Appareils</div><div class="sbar-track"><div class="sbar-fill" style="width:${d.devices.total > 0 ? Math.round(d.devices.online/d.devices.total*100) : 0}%;background:var(--green)"></div></div><div class="sbar-val">${d.devices.online}/${d.devices.total}</div></div>
        ${snap ? `<div class="sbar"><div class="sbar-label">Disque</div><div class="sbar-track"><div class="sbar-fill" style="width:${snap.disk_percent}%;background:${snap.disk_percent > 90 ? 'var(--red)' : snap.disk_percent > 70 ? 'var(--amber)' : 'var(--green)'}"></div></div><div class="sbar-val">${Math.round(snap.disk_percent)}%</div></div>` : ''}
      </div>

      <div class="panel">
        <div class="panel-head"><div class="panel-title">Appareils</div><span class="panel-action" onclick="go('appareils')">Tout voir →</span></div>
        ${devices.length === 0
          ? `<div style="text-align:center;padding:16px;color:var(--text3);font-size:12px">Aucun appareil connecté</div>`
          : devices.slice(0, 4).map(d => deviceMini(d)).join('')
        }
      </div>

      <div class="panel">
        <div class="panel-head"><div class="panel-title">Activité alertes (7j)</div></div>
        <div class="chart-wrap">
          <div class="chart-bars" id="chart"></div>
          <div class="chart-days" id="chartDays"></div>
        </div>
      </div>
    </div>
  </div>`;
}

function resourceBar(label, val, unit) {
  const pct = Math.min(100, Math.round(val || 0));
  const color = pct > 90 ? 'var(--red)' : pct > 70 ? 'var(--amber)' : 'var(--green)';
  return `<div>
    <div style="display:flex;justify-content:space-between;font-size:11px;color:var(--text3);margin-bottom:4px">
      <span>${label}</span>
      <span style="font-family:var(--mono);color:${color}">${pct}${unit}</span>
    </div>
    <div style="height:5px;background:var(--surface3);border-radius:3px;overflow:hidden">
      <div style="width:${pct}%;height:100%;background:${color};border-radius:3px;transition:width 1s"></div>
    </div>
  </div>`;
}

function deviceMini(dev) {
  const isOnline = dev.status === 'online';
  const icon = dev.platform === 'Darwin' ? '🍎' : dev.platform === 'Windows' ? '🪟' : '🐧';
  return `<div class="device-card" onclick="openDevice('${dev.id}')">
    <div class="device-icon">${icon}</div>
    <div class="device-info">
      <div class="device-name">${dev.name}</div>
      <div class="device-meta">${dev.ip_local || '-'} · ${dev.platform}</div>
    </div>
    <div class="device-status">
      <div class="status-dot" style="background:${isOnline ? 'var(--green)' : 'var(--text3)'}"></div>
      <span style="font-size:10px;color:${isOnline ? 'var(--green)' : 'var(--text3)'}">${isOnline ? 'En ligne' : 'Hors ligne'}</span>
    </div>
  </div>`;
}

function alertRow(a) {
  const sevClass = a.severity || 'low';
  return `<div class="alert-item" onclick="openAlert(${a.id})">
    <div class="sev-dot ${sevClass}"></div>
    <div class="alert-body">
      <div class="alert-title">${a.title}</div>
      <div class="alert-meta">${a.device_name} · ${timeAgo(a.created_at)}</div>
    </div>
    <div class="sev-tag tag-${sevClass}">${a.severity.toUpperCase()}</div>
  </div>`;
}

// ═══════════════════════════════════════════════════════
// PAGE : APPAREILS
// ═══════════════════════════════════════════════════════
function pageAppareils() {
  const devices = S.data.devices;
  if (devices.length === 0) {
    return `<div class="empty-state">
      <div class="empty-icon">💻</div>
      <div class="empty-title">Aucun appareil connecté</div>
      <div class="empty-desc">Installez l'agent ShieldFlow sur votre MacBook pour commencer la surveillance.</div>
      <button class="copy-btn" onclick="go('connecter')">→ Connecter mon MacBook</button>
    </div>`;
  }
  return `
  <div class="metrics">
    <div class="mc"><div class="mc-label">Total</div><div class="mc-val">${devices.length}</div></div>
    <div class="mc"><div class="mc-label">En ligne</div><div class="mc-val" style="color:var(--green)">${devices.filter(d=>d.status==='online').length}</div></div>
    <div class="mc"><div class="mc-label">Hors ligne</div><div class="mc-val" style="color:var(--text3)">${devices.filter(d=>d.status!=='online').length}</div></div>
    <div class="mc"><div class="mc-label">Avec alertes</div><div class="mc-val" style="color:var(--amber)">${devices.filter(d=>d.active_alerts>0).length}</div></div>
  </div>
  <div class="panel">
    <div class="panel-head"><div class="panel-title">Tous les appareils</div></div>
    ${devices.map(dev => {
      const isOnline = dev.status === 'online';
      const icon = dev.platform === 'Darwin' ? '🍎' : dev.platform === 'Windows' ? '🪟' : '🐧';
      const snap = dev.latest_snapshot;
      return `<div class="device-card" onclick="openDevice('${dev.id}')">
        <div class="device-icon">${icon}</div>
        <div class="device-info">
          <div class="device-name">${dev.name}</div>
          <div class="device-meta">
            ${dev.hostname} · ${dev.ip_local || '-'} · ${dev.platform}
            ${snap ? ` · CPU ${Math.round(snap.cpu_percent)}% · RAM ${Math.round(snap.ram_percent)}%` : ''}
          </div>
        </div>
        <div style="text-align:right;flex-shrink:0">
          <div class="device-status" style="justify-content:flex-end;margin-bottom:4px">
            <div class="status-dot" style="background:${isOnline ? 'var(--green)' : 'var(--text3)'}"></div>
            <span style="font-size:10px;color:${isOnline ? 'var(--green)' : 'var(--text3)'}">${isOnline ? 'En ligne' : 'Hors ligne'}</span>
          </div>
          ${dev.active_alerts > 0 ? `<div style="font-size:10px;color:var(--red);font-family:var(--mono)">${dev.active_alerts} alerte(s)</div>` : ''}
          <div style="font-size:10px;color:var(--text3);font-family:var(--mono)">Vu ${timeAgo(dev.last_seen)}</div>
        </div>
      </div>`;
    }).join('')}
  </div>`;
}

// ═══════════════════════════════════════════════════════
// PAGE : ALERTES
// ═══════════════════════════════════════════════════════
function pageAlertes() {
  const alerts = S.data.alerts;
  if (alerts.length === 0) {
    return `<div class="empty-state">
      <div class="empty-icon">✅</div>
      <div class="empty-title">Aucune alerte active</div>
      <div class="empty-desc">Votre infrastructure est saine. ShieldFlow surveille en continu et vous alertera dès qu'un problème sera détecté.</div>
    </div>`;
  }
  const order = { critical:0, high:1, medium:2, low:3 };
  const sorted = [...alerts].sort((a,b) => (order[a.severity]||3) - (order[b.severity]||3));
  return `
  <div class="panel">
    <div class="panel-head">
      <div class="panel-title">${alerts.length} alerte(s) active(s)</div>
      <span style="font-size:10px;color:var(--text3);font-family:var(--mono)">Cliquer pour gérer</span>
    </div>
    ${sorted.map(a => alertRow(a)).join('')}
  </div>`;
}

// ═══════════════════════════════════════════════════════
// PAGE : CONNECTER
// ═══════════════════════════════════════════════════════
function pageConnecter() {
  const serverUrl = S.server;
  const secretKey = 'shieldflow-secret-key-change-in-prod';
  return `
  <div class="info-box ok">
    <div class="info-title">✅ Serveur ShieldFlow actif — ${serverUrl}</div>
    <div class="info-text">Votre backend tourne. Suivez les étapes ci-dessous pour connecter votre MacBook.</div>
  </div>

  <div class="panel">
    <div class="panel-head"><div class="panel-title">Étape 1 — Installer les dépendances Python</div></div>
    <div class="info-text" style="margin-bottom:10px">Ouvrez le Terminal sur votre Mac et copiez cette commande :</div>
    <code class="info-cmd" onclick="copyCmd(this, 'pip3 install psutil requests')">pip3 install psutil requests</code>
    <div style="font-size:11px;color:var(--text3);margin-top:6px">Si Python n'est pas installé : <span style="color:var(--accent2);font-family:var(--mono)">brew install python3</span></div>
  </div>

  <div class="panel">
    <div class="panel-head"><div class="panel-title">Étape 2 — Télécharger l'agent</div></div>
    <div class="info-text" style="margin-bottom:10px">L'agent est le fichier <code style="font-family:var(--mono);color:var(--accent2)">agent.py</code> livré dans le dossier <code style="font-family:var(--mono);color:var(--accent2)">shieldflow/agent/</code>.</div>
    <div style="font-size:12px;color:var(--text2)">Placez-le où vous voulez sur votre Mac, par exemple dans votre dossier personnel.</div>
  </div>

  <div class="panel">
    <div class="panel-head"><div class="panel-title">Étape 3 — Lancer l'agent sur votre MacBook</div></div>
    <div class="info-text" style="margin-bottom:10px">Dans le Terminal, lancez cette commande (en remplaçant le chemin vers agent.py si besoin) :</div>
    <code class="info-cmd" onclick="copyCmd(this, 'python3 agent.py --server ${serverUrl} --key ${secretKey} --name \\"Mon MacBook\\"')">python3 agent.py --server ${serverUrl} --key ${secretKey} --name "Mon MacBook"</code>
    <div style="font-size:11px;color:var(--text3);margin-top:8px">L'agent s'enregistre automatiquement et envoie ses données toutes les 60 secondes. Laissez le terminal ouvert.</div>
  </div>

  <div class="panel">
    <div class="panel-head"><div class="panel-title">Étape 4 — Vérifier la connexion</div></div>
    <div class="info-text" style="margin-bottom:12px">Après avoir lancé l'agent, cliquez sur Actualiser pour voir votre MacBook apparaître dans le dashboard.</div>
    <button class="copy-btn" onclick="refreshData().then(()=>go('appareils'))">Actualiser et voir mes appareils →</button>
  </div>

  <div class="info-box warn">
    <div class="info-title">⚠ Note sur les permissions macOS</div>
    <div class="info-text">macOS peut bloquer la lecture de certains ports réseau sans droits admin. Si vous voyez des erreurs de permission, lancez l'agent avec <code style="font-family:var(--mono);color:var(--accent2)">sudo python3 agent.py …</code></div>
  </div>`;
}

// ═══════════════════════════════════════════════════════
// MODALS
// ═══════════════════════════════════════════════════════
async function openDevice(id) {
  document.getElementById('m-title').textContent = 'Chargement…';
  document.getElementById('m-body').innerHTML = '<div class="loading"><div class="spinner"></div></div>';
  document.getElementById('overlay').classList.add('open');

  try {
    const dev = await api('GET', `/api/devices/${id}`);
    const isOnline = dev.status === 'online';
    const snap = dev.snapshots?.[0];
    const icon = dev.platform === 'Darwin' ? '🍎' : dev.platform === 'Windows' ? '🪟' : '🐧';

    document.getElementById('m-title').textContent = `${icon} ${dev.name}`;

    let ports = [];
    if (snap?.open_ports) { try { ports = JSON.parse(snap.open_ports); } catch(e) {} }
    let users = [];
    if (snap?.logged_users) { try { users = JSON.parse(snap.logged_users); } catch(e) {} }

    document.getElementById('m-body').innerHTML = `
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:16px">
        <div class="status-dot" style="background:${isOnline ? 'var(--green)' : 'var(--text3)'}"></div>
        <span style="font-size:12px;color:${isOnline ? 'var(--green)' : 'var(--text3)'}">${isOnline ? 'En ligne' : 'Hors ligne'}</span>
        <span style="font-size:11px;color:var(--text3);font-family:var(--mono)">${dev.hostname} · ${dev.ip_local || '-'} · ${dev.platform}</span>
      </div>

      ${snap ? `
      <div class="stat-grid">
        <div class="stat-box">
          <div class="stat-val" style="color:${snap.cpu_percent > 80 ? 'var(--red)' : 'var(--text)'}">${Math.round(snap.cpu_percent)}%</div>
          <div class="stat-label">CPU</div>
        </div>
        <div class="stat-box">
          <div class="stat-val" style="color:${snap.ram_percent > 80 ? 'var(--amber)' : 'var(--text)'}">${Math.round(snap.ram_percent)}%</div>
          <div class="stat-label">RAM</div>
        </div>
        <div class="stat-box">
          <div class="stat-val" style="color:${snap.disk_percent > 85 ? 'var(--red)' : 'var(--text)'}">${Math.round(snap.disk_percent)}%</div>
          <div class="stat-label">Disque</div>
        </div>
        <div class="stat-box">
          <div class="stat-val">${snap.running_processes}</div>
          <div class="stat-label">Processus</div>
        </div>
        <div class="stat-box">
          <div class="stat-val">${snap.network_connections >= 0 ? snap.network_connections : '—'}</div>
          <div class="stat-label">Connexions</div>
        </div>
        <div class="stat-box">
          <div class="stat-val">${Math.round(snap.uptime_hours)}h</div>
          <div class="stat-label">Uptime</div>
        </div>
      </div>
      <div style="font-size:11px;color:var(--text3);margin-bottom:12px">
        OS : <span style="color:var(--text2)">${snap.os_version || '-'}</span> &nbsp;|&nbsp;
        RAM : <span style="color:var(--text2)">${snap.ram_total_gb} GB</span> &nbsp;|&nbsp;
        Disque : <span style="color:var(--text2)">${snap.disk_total_gb} GB</span>
        ${users.length > 0 ? ` &nbsp;|&nbsp; Utilisateurs : <span style="color:var(--text2)">${users.join(', ')}</span>` : ''}
      </div>
      ${ports.length > 0 ? `
      <div style="margin-bottom:12px">
        <div style="font-size:11px;color:var(--text3);margin-bottom:6px;font-family:var(--mono)">PORTS OUVERTS (${ports.length})</div>
        <div style="display:flex;flex-wrap:wrap;gap:4px">
          ${ports.slice(0,30).map(p => {
            const danger = [22,23,3389,5900].includes(Number(p));
            return `<span style="font-family:var(--mono);font-size:10px;padding:2px 7px;border-radius:4px;background:${danger ? 'rgba(239,68,68,.1)' : 'var(--surface3)'};color:${danger ? 'var(--red)' : 'var(--text3)'}">${p}</span>`;
          }).join('')}
        </div>
      </div>` : ''}` : '<div style="color:var(--text3);font-size:12px;padding:12px 0">Aucune donnée système reçue encore.</div>'}

      ${dev.alerts?.filter(a => !a.resolved).length > 0 ? `
      <div style="margin-top:8px">
        <div style="font-size:11px;color:var(--text3);margin-bottom:8px;font-family:var(--mono)">ALERTES ACTIVES</div>
        ${dev.alerts.filter(a => !a.resolved).slice(0,5).map(a => `
        <div style="background:var(--bg);border:1px solid var(--border);border-radius:7px;padding:9px 11px;margin-bottom:6px;display:flex;align-items:flex-start;gap:8px">
          <div class="sev-dot ${a.severity}" style="margin-top:3px"></div>
          <div>
            <div style="font-size:12px;font-weight:600">${a.title}</div>
            <div style="font-size:11px;color:var(--text2);margin-top:2px">${a.description}</div>
          </div>
        </div>`).join('')}
      </div>` : ''}

      <div class="modal-actions">
        <button class="mbtn mbtn-ghost" onclick="closeModal()">Fermer</button>
      </div>`;
  } catch(e) {
    document.getElementById('m-body').innerHTML = `<div style="color:var(--red);font-size:12px">Erreur lors du chargement : ${e.message}</div>`;
  }
}

async function openAlert(id) {
  const alert = S.data.alerts.find(a => a.id === id);
  if (!alert) return;
  document.getElementById('m-title').textContent = alert.title;
  document.getElementById('overlay').classList.add('open');

  const sevLabel = { critical:'CRITIQUE', high:'ÉLEVÉ', medium:'MOYEN', low:'FAIBLE' };
  document.getElementById('m-body').innerHTML = `
    <div style="margin-bottom:12px">
      <div class="sev-tag tag-${alert.severity}" style="display:inline-flex">${sevLabel[alert.severity] || alert.severity.toUpperCase()}</div>
    </div>
    <div style="font-size:12px;color:var(--text2);line-height:1.7;margin-bottom:14px">
      <strong>Appareil :</strong> ${alert.device_name}<br>
      <strong>Détecté :</strong> ${timeAgo(alert.created_at)}<br>
      <strong>Description :</strong> ${alert.description}
    </div>
    <div class="modal-actions">
      <button class="mbtn mbtn-danger" onclick="resolveAlert(${alert.id})">Marquer comme résolue</button>
      <button class="mbtn mbtn-ghost" onclick="closeModal()">Fermer</button>
    </div>`;
}

async function resolveAlert(id) {
  try {
    await api('POST', `/api/alerts/${id}/resolve`);
    toast('Alerte marquée comme résolue ✅', 'green');
    closeModal();
    await refreshData();
  } catch(e) {
    toast('Erreur lors de la résolution', 'red');
  }
}

function closeModal(e) {
  if (!e || e.target === document.getElementById('overlay')) {
    document.getElementById('overlay').classList.remove('open');
  }
}

// ═══════════════════════════════════════════════════════
// CHART
// ═══════════════════════════════════════════════════════
function renderChart() {
  const el = document.getElementById('chart');
  const labelsEl = document.getElementById('chartDays');
  if (!el) return;
  // Données réelles : compter les alertes par jour sur 7 jours
  const alerts = S.data.alerts;
  const days = [];
  const labels = ['L','M','M','J','V','S','D'];
  const today = new Date();
  for (let i = 6; i >= 0; i--) {
    const d = new Date(today);
    d.setDate(d.getDate() - i);
    const dateStr = d.toISOString().split('T')[0];
    const count = alerts.filter(a => a.created_at.startsWith(dateStr)).length;
    days.push(count);
  }
  const max = Math.max(...days, 1);
  el.innerHTML = '';
  labelsEl.innerHTML = '';
  days.forEach((v, i) => {
    const h = Math.round((v / max) * 56) + 4;
    const isToday = i === 6;
    const b = document.createElement('div');
    b.className = 'chart-bar';
    b.style.cssText = `height:${h}px;background:${isToday ? 'var(--accent2)' : 'var(--surface3)'}`;
    b.title = `${v} alerte(s)`;
    el.appendChild(b);
    const l = document.createElement('div');
    l.className = 'chart-day';
    l.textContent = labels[i];
    if (isToday) l.style.color = 'var(--accent2)';
    labelsEl.appendChild(l);
  });
}

// ═══════════════════════════════════════════════════════
// UTILITAIRES
// ═══════════════════════════════════════════════════════
function timeAgo(iso) {
  if (!iso) return '-';
  const diff = Date.now() - new Date(iso).getTime();
  const m = Math.floor(diff / 60000);
  if (m < 1) return 'à l\'instant';
  if (m < 60) return `il y a ${m} min`;
  const h = Math.floor(m / 60);
  if (h < 24) return `il y a ${h}h`;
  return `il y a ${Math.floor(h/24)}j`;
}

function copyCmd(el, text) {
  navigator.clipboard.writeText(text).then(() => {
    const orig = el.textContent;
    el.textContent = '✅ Copié !';
    setTimeout(() => el.textContent = orig, 1500);
  });
}

function toast(msg, type = 'green') {
  const wrap = document.getElementById('toastwrap');
  const colors = { green: 'var(--green)', red: 'var(--red)', amber: 'var(--amber)', blue: 'var(--accent2)' };
  const t = document.createElement('div');
  t.className = 'toast';
  t.innerHTML = `<div class="toast-ico" style="background:${colors[type]}"></div><span>${msg}</span>`;
  wrap.appendChild(t);
  setTimeout(() => t.classList.add('show'), 50);
  setTimeout(() => { t.classList.remove('show'); setTimeout(() => t.remove(), 400); }, 4000);
}

// ═══════════════════════════════════════════════════════
// INIT
// ═══════════════════════════════════════════════════════
if (S.token) {
  // Token en cache : vérifier qu'il est encore valide
  fetch(S.server + '/api/dashboard', {
    headers: { 'Authorization': `Bearer ${S.token}` }
  }).then(r => {
    if (r.ok) showApp();
    else { S.token = null; localStorage.removeItem('sf_token'); }
  }).catch(() => {
    // Serveur inaccessible — rester sur login
  });
}
</script>
</body>
</html>
